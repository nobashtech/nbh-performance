msgid "%s overlaps with NBH Performance %s optimization."
msgstr "%s overlaps সহ NBH পারফরম্যান্স %s অপ্টিমাইজেশন."

#: Modules/PerformanceIntelligence/PerformanceIntelligenceController.php:174
msgid "%s regressed on %s."
