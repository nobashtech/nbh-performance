#: Modules/Compatibility/CompatibilityRemediationManager.php:502
msgid ""
"%1$s and NBH Performance are both configured to manage %2$s. Duplicate "
"optimization can rewrite the same HTML, CSS, JavaScript or image more than "
"once."
msgstr ""
"%1$s and NBH পারফরম্যান্স are both configured to manage %2$s. Duplicate "
"অপ্টিমাইজেশন can rewrite the same HTML, CSS, JavaScript or ছবি more than "
"once."

#: Modules/Compatibility/CompatibilityRemediationManager.php:602
msgid ""
"%1$s is already managing %2$s. Enabling the same transformation in NBH "
"Performance can cause duplicate markup, missing images, layout shifts, stale"
" cache, or broken JavaScript."
msgstr ""
"%1$s is already managing %2$s. Enabling the same transformation in NBH "
"পারফরম্যান্স can cause duplicate markup, অনুপস্থিত ছবি, layout shifts, stale"
" ক্যাশ, or broken JavaScript."

#: Modules/Compatibility/ConflictDiagnosis.php:22
msgid "%1$s optimization is owned by %2$s."
msgstr "%1$s অপ্টিমাইজেশন is owned by %2$s."

#: Modules/Compatibility/CompatibilityRemediationManager.php:743
msgid ""
"%1$s still reports active %2$s after the attempted change. Its original "
"settings were restored, and NBH Performance remained unchanged."
msgstr ""
"%1$s still রিপোর্ট সক্রিয় %2$s পরে the attempted change. Its মূল সেটিংস "
"পুনরুদ্ধার করা হয়েছে, and NBH পারফরম্যান্স remained unchanged."

#: Modules/Performance/ObjectCacheManager.php:287
msgid "%s connection verified."
msgstr "%s সংযোগ যাচাইকৃত."

#: Modules/Compatibility/CompatibilityRemediationManager.php:699
msgid ""
"%s could not be deactivated automatically. It may be network-managed or "
"protected by your host."
msgstr ""
"%s হতে পারেনি deactivated স্বয়ংক্রিয়ভাবে. It may be network-managed or "
"সুরক্ষিত by আপনার হোস্ট."

#: Modules/Compatibility/CompatibilityRemediationManager.php:143
msgid ""
"%s currently controls WordPress early page caching. NBH Performance paused "
"its page cache and left the existing drop-in untouched."
msgstr ""
"%s currently controls WordPress early পৃষ্ঠা ক্যাশিং. NBH পারফরম্যান্স বিরত "
"its পৃষ্ঠা ক্যাশ and left the বিদ্যমান drop-in untouched."

#: Modules/Compatibility/CompatibilityRemediationManager.php:188
msgid ""
"%s is active while NBH Performance page caching is enabled. Dual page "
"caching can create stale pages, inconsistent purges, or personalized-content"
" risks."
msgstr ""
"%s সক্রিয় আছে যখন NBH পারফরম্যান্স পৃষ্ঠা ক্যাশিং চালু আছে. Dual পৃষ্ঠা "
"ক্যাশিং can তৈরি করুন stale পৃষ্ঠা, inconsistent purges, or personalized-"
"content risks."

